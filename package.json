{
  "name": "pitonne-jp",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": ">=24 <26"
  },
  "scripts": {
    "dev": "pnpm --filter web dev",
    "dev:web": "pnpm --filter web dev",
    "dev:cms": "pnpm --filter cms dev",
    "build": "pnpm --filter web build",
    "build:web": "pnpm --filter web build",
    "build:cms": "pnpm --filter cms build",
    "build:cms:worker": "pnpm --filter cms build:worker",
    "start": "pnpm --filter web start",
    "start:web": "pnpm --filter web start",
    "start:cms": "pnpm --filter cms start",
    "lint": "pnpm --filter web lint",
    "lint:web": "pnpm --filter web lint",
    "lint:cms": "pnpm --filter cms lint",
    "typecheck": "pnpm --filter web typecheck && pnpm --filter cms typecheck",
    "typecheck:web": "pnpm --filter web typecheck",
    "typecheck:cms": "pnpm --filter cms typecheck",
    "test": "pnpm --filter web test",
    "test:web": "pnpm --filter web test",
    "test:watch": "pnpm --filter web test:watch",
    "test:parity": "pnpm --filter web test:parity",
    "test:lighthouse": "pnpm --filter web test:lighthouse",
    "audit:routes": "pnpm --filter web audit:routes",
    "audit:content": "pnpm --filter web audit:content",
    "audit:strings": "pnpm --filter web audit:strings",
    "seed:cms": "pnpm --filter web seed:cms"
  }
}
