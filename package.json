{
  "name": "pitonne-website",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": ">=24 <26"
  },
  "scripts": {
    "dev": "next dev",
    "cms": "KEYSTATIC=1 NEXT_PUBLIC_KEYSTATIC_STORAGE=local next dev",
    "cms:cloud": "KEYSTATIC=1 next dev",
    "build": "next build && node scripts/environment-headers.mjs",
    "start": "node scripts/serve-static.mjs",
    "lint": "biome check",
    "format": "biome format --write",
    "typecheck": "next typegen && tsc --noEmit --incremental false",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:lighthouse": "lhci autorun",
    "audit:strings": "node scripts/audit-hardcoded-strings.mjs",
    "audit:meta": "node scripts/audit-meta-lengths.mjs",
    "audit:seo": "node scripts/audit-seo-build.mjs",
    "audit:out": "node scripts/audit-out.mjs",
    "audit:sheet-images": "node scripts/audit-sheet-images.mjs",
    "translate": "node scripts/translate-content.ts",
    "drafts:fetch": "node scripts/fetch-google-docs.mjs",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm audit:meta && DEPLOY_ENV=production pnpm build && pnpm audit:out && pnpm audit:seo"
  },
  "dependencies": {
    "@keystatic/core": "^0.6.9",
    "@keystatic/next": "^5.0.5",
    "@next/third-parties": "16.2.4",
    "@radix-ui/react-dialog": "1.1.15",
    "clsx": "^2.1.1",
    "gray-matter": "^4.0.3",
    "lucide-react": "^0.564.0",
    "next": "16.2.4",
    "react": "^19",
    "react-dom": "^19",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.3.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.2",
    "@lhci/cli": "^0.15.1",
    "@tailwindcss/postcss": "^4.2.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "happy-dom": "^21.0.4",
    "postcss": "^8.5",
    "saxes": "^6.0.0",
    "schema-dts": "^2.1.0",
    "tailwindcss": "^4.2.0",
    "tw-animate-css": "1.3.3",
    "typescript": "5.7.3",
    "vitest": "^4.1.5",
    "yaml": "^2.9.1"
  }
}
