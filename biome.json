{
  "$schema": "https://biomejs.dev/schemas/2.4.2/schema.json",
  "extends": ["@serpcompany/verify/biome"],
  "files": {
    "includes": ["**", "!.next", "!out", "!.wrangler", "!content", "!public"]
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "linter": {
    "rules": {
      "performance": {
        "noImgElement": "off"
      }
    },
    "domains": {
      "next": "recommended",
      "react": "recommended"
    }
  },
  "overrides": [
    {
      "includes": ["src/components/shared/json-ld.tsx"],
      "linter": {
        "rules": {
          "security": {
            "noDangerouslySetInnerHtml": "off"
          }
        }
      }
    },
    {
      "includes": ["src/lib/**", "!**/*.test.ts", "!**/*.test.tsx"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@/components", "@/components/**", "@/app", "@/app/**"],
                    "message": "src/lib holds the site's data and logic, which components (src/components) and routes (src/app) build on, so it never imports them. Move what both sides need into src/lib."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/components/**", "!**/*.test.ts", "!**/*.test.tsx"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@/app", "@/app/**"],
                    "message": "Routes (src/app) import components, never the reverse. Pass what a component needs from its route as a prop, or move shared code into src/lib."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
