# Generate a strong value with `openssl rand -hex 32`.
PAYLOAD_SECRET=

# Optional, used by generated URLs and preview links.
PAYLOAD_PUBLIC_SERVER_URL=http://localhost:3001

# Optional comma-separated CORS origins for browser API consumers.
PAYLOAD_CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Optional local Wrangler state path, relative to apps/cms.
WRANGLER_PERSIST_PATH=.wrangler/local-dev

# Local-only bootstrap account. Do not use these values in production.
PAYLOAD_LOCAL_ADMIN_EMAIL=local-admin@pitonne.test
PAYLOAD_LOCAL_ADMIN_PASSWORD=local-admin-password

# Local-only Payload MCP key used by .codex/config.toml.
# Create/update the matching key in Payload admin under MCP -> API Keys.
PAYLOAD_MCP_API_KEY=
