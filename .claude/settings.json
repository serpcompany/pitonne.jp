{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -x \"$CLAUDE_PROJECT_DIR\"/node_modules/.bin/serp-verify ]; then \"$CLAUDE_PROJECT_DIR\"/node_modules/.bin/serp-verify hook; elif [ \"$GITHUB_ACTIONS\" != true ]; then echo \"The checks can't run in $CLAUDE_PROJECT_DIR: its packages aren't installed. Run pnpm install there (AGENTS.md, Setup), then make this change again.\" >&2; exit 2; fi",
            "timeout": 30,
            "onFailure": "block"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -x \"$CLAUDE_PROJECT_DIR\"/node_modules/.bin/serp-verify ]; then \"$CLAUDE_PROJECT_DIR\"/node_modules/.bin/serp-verify stop-hook; elif [ \"$GITHUB_ACTIONS\" != true ]; then echo \"The checks can't run in $CLAUDE_PROJECT_DIR: its packages aren't installed. Run pnpm install there (AGENTS.md, Setup).\" >&2; exit 1; fi",
            "timeout": 120
          }
        ]
      }
    ]
  },
  "permissions": {
    "deny": [
      "Bash(wrangler pages project delete*)",
      "Bash(npx wrangler pages project delete*)",
      "Bash(npx wrangler@* pages project delete*)",
      "Bash(pnpm wrangler pages project delete*)",
      "Bash(pnpm exec wrangler pages project delete*)",
      "Bash(pnpm dlx wrangler pages project delete*)",
      "Bash(pnpm dlx wrangler@* pages project delete*)",
      "Bash(*/wrangler pages project delete*)",
      "PowerShell(wrangler pages project delete*)",
      "PowerShell(npx wrangler pages project delete*)",
      "PowerShell(npx wrangler@* pages project delete*)",
      "PowerShell(pnpm wrangler pages project delete*)",
